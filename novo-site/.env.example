# Nunca coloque chaves reais neste arquivo ou no Git.
#
# Site estático (output: "export"): os formulários postam DIRETO nos scripts PHP
# do servidor (/php/sendemail.php e /php/sendcurriculo.php), que guardam as chaves.
# Nenhuma variável de servidor é necessária para publicar o site.

SITE_URL=https://grupoaffix.com.br

# Endpoints dos formulários. Vazio = caminho relativo do próprio domínio, que é o
# certo em produção. No localhost o envio fica em modo demonstração; para testar o
# envio real a partir do localhost, aponte para a URL completa de produção, ex.:
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://grupoaffix.com.br/php/sendemail.php
# NEXT_PUBLIC_CAREERS_ENDPOINT=https://grupoaffix.com.br/php/sendcurriculo.php
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_CAREERS_ENDPOINT=

# reCAPTCHA v2. Quem valida o token é o script PHP, que já tem a chave secreta.
# Só preencha para trocar a chave pública; o padrão do código é a mesma do site atual.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Exibe o banner de consentimento de cookies (só faz sentido com analytics configurado)
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ── Variáveis abaixo só valem para o modo servidor (rotas em docs/api-node/),
#    que volta a ser usado quando o site migrar para a VPS com Node. ──
# CONTACT_PHP_ENDPOINT=
# CONTACT_SEND_IN_DEV=false
# BREVO_API_KEY=
# CONTACT_FROM_EMAIL=ti@grupoaffix.com.br
# CONTACT_TO_EMAIL=comercial@grupoaffix.com.br
# CONTACT_FROM_NAME=Grupo Affix
# CAREERS_TO_EMAIL=
# CAREERS_SEND_IN_DEV=false
# ALLOWED_ORIGIN=https://grupoaffix.com.br
